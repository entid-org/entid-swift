# Generated code is committed so that building this package needs no network
# and no access to the specification repository. Marking it keeps a rules
# update from drowning a review in eleven thousand lines nobody wrote by hand;
# the diff is still there for anyone who asks for it.
Sources/EntID/Generated/** linguist-generated=true
Sources/EntIDWire/Generated/** linguist-generated=true

# The attested artefacts. They are inputs, never edited here.
spec/*.binpb binary
spec/*.jsonl -diff
